# ===== Tushare Pro =====
TUSHARE_TOKEN=your_tushare_token_here
# 每分钟最大调用次数（高积分账号通常 500，低积分账号请按实际权限下调）
TUSHARE_RATE_PER_MIN=480

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=quantify
MYSQL_CHARSET=utf8mb4

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs
