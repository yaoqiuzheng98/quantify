# ===== Tushare Pro =====
TUSHARE_TOKEN=your_tushare_token_here
# 每分钟最大调用次数（高积分账号通常 500，低积分账号请按实际权限下调）
TUSHARE_RATE_PER_MIN=480
# 并发采集线程数。镜像站 jiaoch.site 并发硬上限为 2；官方 API 无并发墙，
# 切到官方后可调大（仍受每分钟频次限制约束）
TUSHARE_MAX_WORKERS=2
# Tushare API 地址（默认使用镜像站，如需切换官方地址请改为 https://api.tushare.pro）
TUSHARE_HTTP_URL=http://jiaoch.site
# 单次 HTTP 请求超时（秒），镜像站大响应偶发截断时可适当调大
TUSHARE_HTTP_TIMEOUT=30

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=quantify
MYSQL_CHARSET=utf8mb4

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== LLM (因子挖掘，默认 DeepSeek；任意 OpenAI 兼容服务可改 base_url/model) =====
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ===== Qlib 数据层（因子挖掘用，由 `quantify factor dump-data` 生成 .bin） =====
# 留空则用项目根目录下 qlib_data/cn_data
QLIB_PROVIDER_URI=
QLIB_REGION=cn
